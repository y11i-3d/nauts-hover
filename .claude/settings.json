{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs bunx prettier --config ./prettier.config.agent.mjs --write || true"
          }
        ]
      }
    ]
  }
}
