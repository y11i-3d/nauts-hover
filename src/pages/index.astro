---
import Layout from "../layouts/Layout.astro";

const members = Array.from({ length: 9 }, (_, i) => ({
  image: `${import.meta.env.BASE_URL}images/${String(i + 1).padStart(3, "0")}.webp`,
  role: "dolor sit amet",
  name: "Lorem Ipsum",
}));
---

<Layout>
  <main
    class="flex min-h-screen w-full flex-col gap-16 bg-neutral-200 p-16 text-neutral-900"
  >
    <h1 class="text-2xl font-bold">Members</h1>
    <ul
      class="grid w-full list-none grid-cols-[repeat(auto-fit,minmax(360px,1fr))] gap-x-8 gap-y-16"
    >
      {
        members.map((member) => (
          <li class="flex items-center gap-8">
            <div class="h-60 w-45 shrink-0 overflow-hidden border-2 border-white">
              <img
                src={member.image}
                alt={member.name}
                class="size-full object-cover"
              />
            </div>
            <div class="flex w-45 flex-col gap-2">
              <p class="text-base">{member.role}</p>
              <p class="text-xl font-bold">{member.name}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
