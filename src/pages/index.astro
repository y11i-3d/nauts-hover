---
import Layout from "../layouts/Layout.astro";

const members = Array.from({ length: 9 }, () => ({
  role: "dolor sit amet",
  name: "Lorem Ipsum",
}));
---

<Layout>
  <main
    class="flex min-h-screen w-full flex-col gap-16 bg-[#e6e6e6] p-16 text-[#1e1e1e]"
  >
    <h1 class="text-2xl font-bold">Members</h1>
    <ul
      class="grid w-full list-none grid-cols-[repeat(auto-fit,minmax(331px,1fr))] gap-x-8 gap-y-16"
    >
      {
        members.map((member) => (
          <li class="flex items-center gap-8">
            <div class="h-60 w-45 shrink-0 border-2 border-white bg-neutral-300" />
            <div class="flex w-[119px] flex-col gap-2">
              <p class="text-base">{member.role}</p>
              <p class="text-xl font-bold">{member.name}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
