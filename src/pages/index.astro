---
import Layout from "../layouts/Layout.astro";

const order = [7, 6, 5, 4, 9, 3, 1, 8, 2];

const videos: Record<number, string> = {
  1: `${import.meta.env.BASE_URL}videos/001-dance-r.mp4`,
  5: `${import.meta.env.BASE_URL}videos/005-dance-l.mp4`,
  7: `${import.meta.env.BASE_URL}videos/007-dance-r.mp4`,
  9: `${import.meta.env.BASE_URL}videos/009-dance.mp4`,
};

const members = order.map((id) => {
  const base = `${import.meta.env.BASE_URL}images/${String(id).padStart(3, "0")}`;
  return {
    id,
    image1x: `${base}.webp`,
    image2x: `${base}@2x.webp`,
    video: videos[id] ?? null,
    role: "dolor sit amet",
    name: "Lorem Ipsum",
  };
});
---

<Layout>
  <main
    class="flex min-h-screen w-full flex-col gap-16 overflow-hidden px-16 py-32 text-neutral-900"
  >
    <div
      data-stage
      class="mx-auto flex w-full max-w-7xl flex-col gap-16 transition-transform duration-800 ease-[cubic-bezier(0.16,1,0.3,1)] has-[[data-thumb]:hover]:scale-125"
    >
      <h1 class="text-2xl font-bold">Members</h1>
      <ul
        class="group/members relative grid w-full list-none grid-cols-3 gap-x-8 gap-y-16"
      >
        {
          members.map((member) => (
            <li class="flex items-center gap-8">
              <div
                data-thumb
                data-id={member.id}
                class:list={[
                  "group relative h-60 w-45 shrink-0 cursor-pointer overflow-hidden transition-[transform,width,margin] duration-400 [--frame-w:0px] group-has-[[data-thumb]:hover]/members:not-hover:pointer-events-none after:pointer-events-none after:absolute after:inset-0 after:border-[length:var(--frame-w)] after:border-white after:transition-[border-width] after:duration-150 ease-[cubic-bezier(0.25,1,0.5,1)] hover:[--frame-w:4px]",
                  member.video && "hover:-mx-7.5 hover:w-60",
                  member.id !== 9 && "pointer-events-none",
                  [1, 5, 7].includes(member.id) && "z-30",
                  member.id === 9 && "z-20",
                ]}
              >
                <div class="relative size-full border-2 border-white">
                  <picture class="contents">
                    <source
                      media="(min-resolution: 1.5dppx)"
                      srcset={member.image2x}
                    />
                    <img
                      src={member.image1x}
                      alt={member.name}
                      class="size-full object-cover"
                    />
                  </picture>
                  {member.video && (
                    <video
                      src={member.video}
                      muted
                      loop
                      playsinline
                      preload="auto"
                      data-hover-play
                      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-150 group-hover:opacity-100"
                    />
                  )}
                </div>
              </div>
              <div class="flex w-45 flex-col gap-2 transition-opacity duration-100 group-has-[[data-thumb]:hover]/members:opacity-0">
                <p class="text-base">{member.role}</p>
                <p class="text-xl font-bold">{member.name}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <div data-warmup-gate class="fixed inset-0 z-50 bg-white"></div>

  <script>
    const WARMUP_TIMEOUT_MS = 5000;

    const videos = document.querySelectorAll<HTMLVideoElement>(
      "video[data-hover-play]",
    );

    for (const video of videos) {
      const trigger = video.parentElement;
      if (!trigger) continue;

      trigger.addEventListener("mouseenter", () => {
        video.currentTime = 0;
        void video.play();
      });
      trigger.addEventListener("mouseleave", () => {
        video.pause();
      });
    }

    const stage = document.querySelector<HTMLElement>("[data-stage]");

    for (const thumb of document.querySelectorAll<HTMLElement>(
      "[data-thumb]",
    )) {
      thumb.addEventListener("mouseenter", () => {
        if (!stage) return;
        const thumbRect = thumb.getBoundingClientRect();
        const stageRect = stage.getBoundingClientRect();
        const originX = thumbRect.left - stageRect.left + thumbRect.width / 2;
        const originY = thumbRect.top - stageRect.top + thumbRect.height / 2;
        stage.style.transformOrigin = `${originX}px ${originY}px`;
      });
    }

    const center = document.querySelector<HTMLElement>('[data-id="9"]');
    const movers = [
      {
        el: document.querySelector<HTMLElement>('[data-id="1"]'),
        rotate: -20,
        distanceX: 0.45,
        distanceY: 0.35,
      },
      {
        el: document.querySelector<HTMLElement>('[data-id="5"]'),
        rotate: 15,
        distanceX: 0.35,
        distanceY: 0.8,
      },
      {
        el: document.querySelector<HTMLElement>('[data-id="7"]'),
        rotate: -10,
        distanceX: 0.45,
        distanceY: 0.3,
      },
    ];

    const jitter = (range: number) => (Math.random() * 2 - 1) * range;

    if (center) {
      center.addEventListener("mouseenter", () => {
        const cx = center.offsetLeft + center.offsetWidth / 2;
        const cy = center.offsetTop + center.offsetHeight / 2;
        const durations = [0.4, 0.7, 0.9];
        for (let i = durations.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [durations[i], durations[j]] = [durations[j], durations[i]];
        }
        movers.forEach(({ el, rotate, distanceX, distanceY }, index) => {
          if (!el) return;
          const dx =
            (cx - (el.offsetLeft + el.offsetWidth / 2)) *
            (distanceX + jitter(0.05));
          const dy =
            (cy - (el.offsetTop + el.offsetHeight / 2)) *
            (distanceY + jitter(0.05));
          const angle = rotate + jitter(10);
          el.style.transitionDuration = `${durations[index]}s`;
          el.style.transitionTimingFunction = "cubic-bezier(0.16,1,0.3,1)";
          el.style.transform = `translate(${dx}px, ${dy}px) rotate(${angle}deg)`;
          el.style.width = "240px";
          el.style.marginInline = "-30px";
          el.style.setProperty("--frame-w", "4px");

          const video = el.querySelector<HTMLVideoElement>("video");
          if (video) {
            video.style.opacity = "1";
            video.currentTime = 0;
            void video.play();
          }
        });
      });

      center.addEventListener("mouseleave", () => {
        for (const { el } of movers) {
          if (!el) continue;
          el.style.transitionDuration = "0.6s";
          el.style.transform = "";
          el.style.width = "";
          el.style.marginInline = "";
          el.style.removeProperty("--frame-w");

          const video = el.querySelector<HTMLVideoElement>("video");
          if (video) {
            video.style.opacity = "";
            video.pause();
          }
        }
      });
    }

    const warmupAborter = new AbortController();
    const warmupSignal = warmupAborter.signal;

    const waitForEnoughData = (video: HTMLVideoElement) =>
      new Promise<void>((resolve, reject) => {
        if (
          warmupSignal.aborted ||
          video.readyState >= video.HAVE_ENOUGH_DATA
        ) {
          resolve();
          return;
        }
        const options = { once: true, signal: warmupSignal };
        video.addEventListener("canplaythrough", () => resolve(), options);
        video.addEventListener("error", () => reject(video.error), options);
        warmupSignal.addEventListener("abort", () => resolve(), {
          once: true,
        });
      });

    const waitForFrame = (video: HTMLVideoElement) =>
      new Promise<void>((resolve) => {
        if (warmupSignal.aborted) {
          resolve();
          return;
        }
        if (typeof video.requestVideoFrameCallback === "function") {
          const handle = video.requestVideoFrameCallback(() => resolve());
          warmupSignal.addEventListener(
            "abort",
            () => {
              video.cancelVideoFrameCallback(handle);
              resolve();
            },
            { once: true },
          );
          return;
        }
        const fallbackTimer = setTimeout(resolve, 50);
        warmupSignal.addEventListener(
          "abort",
          () => {
            clearTimeout(fallbackTimer);
            resolve();
          },
          { once: true },
        );
      });

    const warmup = async (video: HTMLVideoElement) => {
      await waitForEnoughData(video);
      if (warmupSignal.aborted) return;
      await video.play();
      if (warmupSignal.aborted) return;
      await waitForFrame(video);
      if (warmupSignal.aborted) return;
      video.pause();
      video.currentTime = 0;
    };

    const removeGate = () => {
      document.querySelector("[data-warmup-gate]")?.remove();
    };

    const warmupTimer = setTimeout(() => {
      warmupAborter.abort();
      for (const video of videos) {
        video.pause();
        video.currentTime = 0;
      }
      removeGate();
    }, WARMUP_TIMEOUT_MS);

    void Promise.allSettled(Array.from(videos, warmup)).then(() => {
      if (warmupSignal.aborted) return;
      clearTimeout(warmupTimer);
      removeGate();
    });
  </script>
</Layout>
